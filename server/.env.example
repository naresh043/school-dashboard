PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/guru_sri_vidya_mandira
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d
COOKIE_SECURE=false

# Required only when intentionally running `npm run seed:demo` against local MongoDB.
ALLOW_DEMO_SEED=false
SEED_HOD_NAME=S. Raghavendra Rao
SEED_HOD_EMAIL=hod@example.local
SEED_HOD_PASSWORD=replace_with_a_unique_password_at_least_12_chars

# Optional until a properly licensed model is selected and deployed.
# Keep the service private and set this URL to its internal network address.
RECOGNITION_SERVICE_URL=http://127.0.0.1:8001
RECOGNITION_SERVICE_SECRET=replace_with_a_random_internal_secret_at_least_32_chars
RECOGNITION_MODEL_ID=unconfigured
RECOGNITION_MODEL_VERSION=unconfigured
# Example format only; use a generated base64-encoded 32-byte key.
FACE_TEMPLATE_KEY=
# Must be set from representative consenting-adult evaluation before deployment.
FACE_MATCH_THRESHOLD=0.7
