PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/guru_sri_vidya_mandira
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d
COOKIE_SECURE=false

# Required only when intentionally running `npm run seed:demo` against local MongoDB.
ALLOW_DEMO_SEED=false
SEED_HOD_NAME=S. Raghavendra Rao
SEED_HOD_EMAIL=hod@example.local
SEED_HOD_PASSWORD=replace_with_a_unique_password_at_least_12_chars

# Client-demo mode: recognition is disabled; no Python service, model, or
# biometric-template key is needed. Local browser face detection remains separate.
FACE_RECOGNITION_ENABLED=false

# Future approved provider only. Set FACE_RECOGNITION_ENABLED=true after model
# licensing, implementation, security/privacy review, and threshold evaluation.
# RECOGNITION_SERVICE_URL=https://private-recognition.internal
# RECOGNITION_SERVICE_SECRET=generated-secret-at-least-32-characters
# RECOGNITION_MODEL_ID=approved-model-id
# RECOGNITION_MODEL_VERSION=approved-model-version
# FACE_TEMPLATE_KEY=base64-encoded-generated-32-byte-key
# FACE_MATCH_THRESHOLD=<evaluation-derived-value>
